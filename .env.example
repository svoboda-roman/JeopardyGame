# Postgres
DATABASE_URL=postgres://jeopardy:jeopardy@localhost:5432/jeopardy

# better-auth
BETTER_AUTH_SECRET=change-me-to-32-or-more-random-bytes
BETTER_AUTH_URL=http://localhost:3000

# CORS — origin of the Vite dev server
WEB_ORIGIN=http://localhost:5173

# Mailer: smtp (MailHog in dev) | resend (prod)
MAILER=smtp
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=no-reply@jeopardy.local

# Only needed when MAILER=resend
RESEND_API_KEY=
